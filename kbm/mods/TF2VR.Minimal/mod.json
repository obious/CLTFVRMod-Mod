  "Scripts": [
    {
      "Path": "tf2vr_settings.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "TF2VR_AddSettingsMenu"
      }
    },
    {
      "Path": "tf2vr_menu.nut",
      "RunOn": "UI",
      "UICallback": {
        "After": "TF2VR_MenuInit"
      }
    },
    {
      "Path": "tf2vr_minimal_stubs.gnut",
      "RunOn": "SP"
    },
    {
      "Path": "tf2vr_minimal_body.nut",
      "RunOn": "CLIENT && SP"
    },
    {
      "Path": "tf2vr_minimal_embark.nut",
      "RunOn": "CLIENT && SP"
    },
    {
      "Path": "tf2vr_minimal_memories.nut",
      "RunOn": "CLIENT && SP"
    },
    {
      "Path": "tf2vr_minimal_commands.nut",
      "RunOn": "UI"
    }
  ],
  "ConCommands": [
    {
      "Name": "tf2vr_recenter",
      "Function": "TF2VR_RecenterCommand",
      "Context": "UI",
      "HelpString": "recenter the VR view (bind it to a key: bind F9 tf2vr_recenter)"
    },
    {
      "Name": "tf2vr_switch_eye",
      "Function": "TF2VR_SwitchEyeCommand",
      "Context": "UI",
      "HelpString": "line the sights up with the other eye when aiming down sights (tf2vr_ads_eye -1 <-> 1)"
    },
    {
      "Name": "tf2vr_toggle_barf",
      "Function": "TF2VR_ToggleBarfCommand",
      "Context": "UI",
      "HelpString": "turn mouse up/down tilting the VR view on or off (tf2vr_barf_mode)"
    }
  ]
}
