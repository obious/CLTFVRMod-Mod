{
  "Name": "TF2VR.Minimal",
  "Description": "Bare glue for the Titanfall2VR plugin without the cockpit/interaction scripts",
  "Version": "0.1.0",
  "LoadPriority": 2,
  "Localisation": [
    "resource/tf2vr_english.txt"
  ],
  "ConVars": [
    {
      "Name": "tf2vr_ads_eye",
      "DefaultValue": "-1",
      "Flags": "ARCHIVE_PLAYERPROFILE",
      "HelpString": "eye the sights line up with when aiming down sights: -1 left, 1 right, 0 between the eyes"
    },
    {
      "Name": "tf2vr_ads_drop",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE",
      "HelpString": "metres to lower the gun when aiming down sights (negative raises it)"
    },
    {
      "Name": "tf2vr_barf_mode",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE",
      "HelpString": "mouse up/down tilts the VR view like a flat screen: 0 off, 1 full (fractions scale it)"
    },
    {
      "Name": "tf2vr_ads_hold",
      "DefaultValue": "1",
      "Flags": "ARCHIVE_PLAYERPROFILE",
      "HelpString": "with barf mode, aiming down sights renders the view without the head's up/down tilt, so the sights line up with the mouse aim: 0 off, 1 full"
    },
    {
      "Name": "tf2vr_realign_body",
      "DefaultValue": "0",
      "HelpString": "while 1, the plugin's view code re-aligns the body with the head as with a menu up (set briefly by tf2vr_recenter)"
    },
    {
      "Name": "tf2vr_skip_cal",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE",
      "HelpString": "1 skips the arm-span/height calibration at startup; recenter once seated instead"
    },
    {
      "Name": "tf2vr_snap_turn",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_turn_speed",
      "DefaultValue": "210",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_snap_angle",
      "DefaultValue": "45",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_gun_angle_offset",
      "DefaultValue": "-15",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_toggle_grip",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_head_hud",
      "DefaultValue": "1",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_titan_hud",
      "DefaultValue": "1",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "tf2vr_hitmarkers",
