<UserControl x:Class="BigWalkVRInstaller.SupportFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- CLTFVRMod-Mod: credits CircuitLord's mod; the Button.Click bubbles to the window, which opens his GitHub -->
    <StackPanel HorizontalAlignment="Center">
        <TextBlock Text="A mod of CircuitLord's Titanfall 2 Mod by Obious" FontSize="11.5" FontStyle="Italic"
                   Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" />
        <Button Style="{StaticResource Quiet}" Content="CircuitLord on GitHub" FontSize="11.5" Padding="6,3"
                HorizontalAlignment="Center" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
