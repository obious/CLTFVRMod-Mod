<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CLTFVRModLauncher</AssemblyName>
    <!-- the UAC prompt shows the title -->
    <AssemblyTitle>CLTFVRMod-Mod Launcher</AssemblyTitle>
    <Product>CLTFVRMod-Mod Launcher</Product>
    <RootNamespace>BigWalkVRInstaller</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\big-walk.jpg" />
    <Resource Include="Assets\titanfall-2.jpg" />
  </ItemGroup>

  <!-- keyboard/mouse patch set and our own script mod (kbm/), applied by TitanfallKbm; listed one by one so
       the Titanfall 2 VR menu files install.py copies into a dev checkout never get embedded -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\kbm\kbm.json" LogicalName="kbm/kbm.json" />
    <EmbeddedResource Include="..\..\kbm\mods\TF2VR.Minimal\mod.json" LogicalName="kbm/mod/mod.json" />
    <EmbeddedResource Include="..\..\kbm\mods\TF2VR.Minimal\mod\scripts\vscripts\tf2vr_minimal_*.*"
                      LogicalName="kbm/mod/mod/scripts/vscripts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyVersionedInstaller" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName)-$(Version)$(TargetExt)" />
    <Copy SourceFiles="$(TargetPath).config" DestinationFiles="$(TargetDir)$(AssemblyName)-$(Version)$(TargetExt).config" />
  </Target>

</Project>
